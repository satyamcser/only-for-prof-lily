# Copy to .env.local for local development. NEVER commit real values.
# Only browser-safe values belong here: everything prefixed VITE_ ends up in the public JS bundle.

# Supabase → Project Settings → API (or "Connect"): Project URL + publishable (anon) key.
# NEVER put the service_role / secret key or the database password anywhere in this project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# GitHub repository name -> Vite base path "/<repo>/". Use "<user>.github.io" for a root site.
VITE_GITHUB_REPO_NAME=only-for-prof-lily

# Optional: override the base path completely (e.g. "/" for a custom domain).
# VITE_BASE_PATH=/

# Optional: ship the in-memory MOCK backend in a production build (fake players, nothing is saved).
# Leave unset for the real gift. In `npm run dev` without Supabase values, mock mode is automatic.
# VITE_DEMO_MODE=true
